# Foliovanta environment template. Copy to .env.local and fill in real values.
# NEVER commit real secrets. Only NEXT_PUBLIC_* values are exposed to the browser.

# --- App ---
APP_ENV=development                       # development | staging | production (staging/production => strict security mode)
NEXT_PUBLIC_APP_URL=http://localhost:3000 # canonical origin; used for public URLs, canonical/OG, sitemap
# SECURITY_MODE=strict                     # optional explicit override of strict/relaxed (else derived from APP_ENV/NODE_ENV)

# --- Clerk (auth) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...               # server-only
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding
CLERK_WEBHOOK_SIGNING_SECRET=              # server-only; Clerk webhook (Svix) signing secret

# --- Database (Neon / Prisma) ---
DATABASE_URL=                              # pooled connection (runtime)
DIRECT_URL=                                # direct connection (migrations, prisma CLI)

# --- Cloudflare R2 (private media) ---
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=                          # server-only
R2_SECRET_ACCESS_KEY=                      # server-only

# --- Upstash Redis (distributed rate limiting; REQUIRED in strict mode) ---
UPSTASH_REDIS_REST_URL=                    # server-only
UPSTASH_REDIS_REST_TOKEN=                  # server-only

# --- Cloudflare Turnstile (anonymous abuse-report protection; REQUIRED in strict mode) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=            # public widget key
TURNSTILE_SECRET_KEY=                      # server-only
# TURNSTILE_EXPECTED_HOSTNAME=foliovanta.com  # optional: pin the solved hostname

# --- Anti-spam / ops ---
ANTISPAM_SALT=                             # server-only; salts the anonymous network hash (rotating resets buckets)
MEDIA_CLEANUP_SECRET=                      # server-only; authorizes the internal media-cleanup endpoint
# ALLOW_PROD_ROLE_BOOTSTRAP=1              # server-only; only to run the admin role-grant CLI against production
