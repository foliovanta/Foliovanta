generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETION_PENDING
}

enum ClerkWebhookEventStatus {
  PROCESSING
  PROCESSED
  IGNORED
}

model User {
  id          String     @id @default(uuid()) @db.Uuid
  clerkUserId String     @unique
  email       String?
  name        String?
  avatarUrl   String?
  role        UserRole   @default(USER)
  status      UserStatus @default(ACTIVE)

  portfolios Portfolio[]

  clerkEventTimestamp DateTime?
  clerkDeletedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("users")
}

model ClerkWebhookEvent {
  id             String                  @id
  clerkUserId    String
  eventType      String
  eventStatus    ClerkWebhookEventStatus @default(PROCESSING)
  eventTimestamp DateTime

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([clerkUserId, eventTimestamp])
  @@map("clerk_webhook_events")
}

enum PortfolioPublicationStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

enum PortfolioModerationStatus {
  CLEAR
  UNDER_REVIEW
  SUSPENDED
}

model Portfolio {
  id      String @id @default(uuid()) @db.Uuid
  ownerId String @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  slug  String  @unique
  title String?

  publicationStatus PortfolioPublicationStatus @default(DRAFT)
  moderationStatus  PortfolioModerationStatus  @default(CLEAR)

  draftRevision     BigInt @default(0)
  nextVersionNumber Int    @default(1)

  lastDraftSavedAt DateTime?
  publishedAt      DateTime?
  deletedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([publicationStatus, moderationStatus])
  @@map("portfolios")
}
