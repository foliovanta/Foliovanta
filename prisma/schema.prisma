generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETION_PENDING
}

enum ClerkWebhookEventStatus {
  PROCESSING
  PROCESSED
  IGNORED
}

model User {
  id          String     @id @default(uuid()) @db.Uuid
  clerkUserId String     @unique
  email       String?
  name        String?
  avatarUrl   String?
  role        UserRole   @default(USER)
  status      UserStatus @default(ACTIVE)

  portfolios Portfolio[]

  clerkEventTimestamp DateTime?
  clerkDeletedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("users")
}

model ClerkWebhookEvent {
  id             String                  @id
  clerkUserId    String
  eventType      String
  eventStatus    ClerkWebhookEventStatus @default(PROCESSING)
  eventTimestamp DateTime

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([clerkUserId, eventTimestamp])
  @@map("clerk_webhook_events")
}

enum PortfolioPublicationStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

enum PortfolioModerationStatus {
  CLEAR
  UNDER_REVIEW
  SUSPENDED
}

model Portfolio {
  id      String @id @default(uuid()) @db.Uuid
  ownerId String @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  slug  String  @unique
  title String?

  publicationStatus PortfolioPublicationStatus @default(DRAFT)
  moderationStatus  PortfolioModerationStatus  @default(CLEAR)

  draftRevision     BigInt @default(0)
  nextVersionNumber Int    @default(1)

  lastDraftSavedAt DateTime?
  publishedAt      DateTime?
  deletedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Draft content (relational). Published snapshots are a separate future model.
  profile     PortfolioProfile?
  sections    PortfolioSection[]
  projects    Project[]
  experiences Experience[]
  education   Education[]
  skills      Skill[]

  @@index([ownerId])
  @@index([publicationStatus, moderationStatus])
  @@map("portfolios")
}

model PortfolioProfile {
  portfolioId String    @id @db.Uuid
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  displayName   String  @default("")
  headline      String?
  bio           String?
  location      String?
  avatarAssetId String? @db.Uuid
  emailPublic   String?

  updatedAt DateTime @updatedAt

  @@map("portfolio_profiles")
}

model PortfolioSection {
  id          String    @id @default(uuid()) @db.Uuid
  portfolioId String    @db.Uuid
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  sectionKey    String
  isVisible     Boolean @default(true)
  position      Int     @default(0)
  layoutVariant String?
  config        Json    @default("{}") @db.JsonB

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([portfolioId, sectionKey])
  @@index([portfolioId, position])
  @@map("portfolio_sections")
}

model Project {
  id          String    @id @default(uuid()) @db.Uuid
  portfolioId String    @db.Uuid
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  title         String
  summary       String?
  description   String?
  projectUrl    String?
  repositoryUrl String?
  coverAssetId  String? @db.Uuid
  isFeatured    Boolean @default(false)
  position      Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([portfolioId, position, id])
  @@map("projects")
}

model Experience {
  id          String    @id @default(uuid()) @db.Uuid
  portfolioId String    @db.Uuid
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  organization String
  roleTitle    String
  location     String?
  startDate    DateTime? @db.Date
  endDate      DateTime? @db.Date
  isCurrent    Boolean   @default(false)
  description  String?
  position     Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([portfolioId, position, id])
  @@map("experiences")
}

model Education {
  id          String    @id @default(uuid()) @db.Uuid
  portfolioId String    @db.Uuid
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  institution  String
  degree       String?
  fieldOfStudy String?
  startDate    DateTime? @db.Date
  endDate      DateTime? @db.Date
  description  String?
  position     Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([portfolioId, position, id])
  @@map("education")
}

model Skill {
  id          String    @id @default(uuid()) @db.Uuid
  portfolioId String    @db.Uuid
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  name        String
  category    String?
  proficiency String?
  position    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([portfolioId, position, id])
  @@map("skills")
}
