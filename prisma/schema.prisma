generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETION_PENDING
}

enum ClerkWebhookEventStatus {
  PROCESSING
  PROCESSED
  IGNORED
}

model User {
  id          String     @id @default(uuid()) @db.Uuid
  clerkUserId String     @unique
  email       String?
  name        String?
  avatarUrl   String?
  role        UserRole   @default(USER)
  status      UserStatus @default(ACTIVE)

  clerkEventTimestamp DateTime?
  clerkDeletedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("users")
}

model ClerkWebhookEvent {
  id             String                  @id
  clerkUserId    String
  eventType      String
  eventStatus    ClerkWebhookEventStatus @default(PROCESSING)
  eventTimestamp DateTime

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([clerkUserId, eventTimestamp])
  @@map("clerk_webhook_events")
}
