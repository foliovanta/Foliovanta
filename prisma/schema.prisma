generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
}

enum FeedbackCategory {
  BUG
  FEATURE_REQUEST
  USABILITY
  OTHER
}

enum FeedbackStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum AbuseReportReason {
  HARASSMENT
  IMPERSONATION
  SPAM
  INAPPROPRIATE
  IP_CONCERN
  OTHER
}

enum AbuseReportStatus {
  OPEN
  IN_REVIEW
  ACTIONED
  DISMISSED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETION_PENDING
}

enum ClerkWebhookEventStatus {
  PROCESSING
  PROCESSED
  IGNORED
}

model User {
  id          String     @id @default(uuid()) @db.Uuid
  clerkUserId String     @unique
  email       String?
  name        String?
  avatarUrl   String?
  role        UserRole   @default(USER)
  status      UserStatus @default(ACTIVE)

  // Immutable, globally unique numeric public identity. Allocated by the
  // `users_public_slug_seq` sequence (DB default) — never reused, never changed
  // (a BEFORE UPDATE trigger enforces immutability). Serialized as a string at
  // API boundaries (BigInt). The username below is the editable URL label.
  publicSlug BigInt @unique @default(dbgenerated("nextval('users_public_slug_seq'::regclass)"))
  // Editable, URL-safe, NOT unique. Presentation only — never an identity key.
  username   String @default("portfolio")

  portfolios        Portfolio[]
  publishedVersions PortfolioVersion[] @relation("VersionPublisher")
  mediaAssets       MediaAsset[]
  feedback          Feedback[]         @relation("UserFeedback")
  reportsSubmitted  AbuseReport[]      @relation("ReportReporter")

  clerkEventTimestamp DateTime?
  clerkDeletedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("users")
}

model ClerkWebhookEvent {
  id             String                  @id
  clerkUserId    String
  eventType      String
  eventStatus    ClerkWebhookEventStatus @default(PROCESSING)
  eventTimestamp DateTime

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([clerkUserId, eventTimestamp])
  @@map("clerk_webhook_events")
}

// Durable, append-only record of privileged/administrative actions and denied
// access attempts. Immutability is enforced at the database (a trigger blocks
// UPDATE/DELETE); ordinary application code only ever INSERTs. Never stores
// credentials, session tokens, or raw request bodies — only safe structured
// metadata.
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  // The internal actor id, when one is resolved. Null for operator/CLI actions
  // (bootstrap) and for denied attempts where no user row resolves. Deliberately
  // NOT a foreign key: an audit record is a permanent historical fact, so the
  // actor id is preserved verbatim even after the account is deleted (and the
  // append-only trigger can block every UPDATE without a FK cascade fighting it).
  actorUserId String? @db.Uuid

  // Stable dotted identifier, e.g. "admin.role.granted", "admin.access.denied".
  action     String
  targetType String?
  targetId   String?
  outcome    AuditOutcome @default(SUCCESS)

  // Request/correlation id linking this record to its request and operational
  // logs. Safe, structured, non-sensitive context only.
  correlationId String?
  metadata      Json?   @db.JsonB

  createdAt DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  // Newest-first keyset list (createdAt DESC, id DESC) and correlation-id lookup
  // for the audit explorer (M6.5.1).
  @@index([createdAt, id])
  @@index([correlationId])
  @@map("audit_logs")
}

// Durable idempotency ledger for privileged moderation commands. One row per
// client-supplied idempotency key: a repeat of the SAME key + payload returns
// the recorded result without re-applying the transition; the same key with a
// DIFFERENT payload fingerprint is rejected. Write-once (never updated).
model ModerationCommand {
  id             String @id @default(uuid()) @db.Uuid
  idempotencyKey String @unique
  actorUserId    String @db.Uuid
  operation      String
  targetType     String
  targetId       String
  // SHA-256 of the canonical command payload, to detect key reuse with a
  // different payload.
  fingerprint String
  // The exact typed result to replay on a repeat (safe, non-sensitive).
  result Json @db.JsonB

  createdAt DateTime @default(now())

  @@index([targetType, targetId])
  @@map("moderation_commands")
}

// Product feedback from an authenticated creator. Private administrative record
// (never publicly visible). Minimal PII: the submitter is referenced by id only.
model Feedback {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation("UserFeedback", fields: [userId], references: [id], onDelete: Cascade)

  // Optional related portfolio — only set when ownership was verified at submit.
  portfolioId String?    @db.Uuid
  portfolio   Portfolio? @relation("PortfolioFeedback", fields: [portfolioId], references: [id], onDelete: SetNull)

  category FeedbackCategory
  message  String
  status   FeedbackStatus @default(OPEN)

  // Optional triage fields (admin-only). assigneeId is a bare UUID (no FK).
  assigneeId      String?   @db.Uuid
  resolutionNote  String?
  statusChangedAt DateTime?
  resolvedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([category, createdAt])
  @@index([userId, createdAt])
  @@map("feedback")
}

// Abuse report against a publicly-eligible portfolio. Private administrative
// record. Reporter identity is optional and NEVER disclosed to the owner; it is
// SetNull on reporter deletion so report history survives account removal. No
// raw IP or device fingerprint is stored.
model AbuseReport {
  id          String    @id @default(uuid()) @db.Uuid
  portfolioId String    @db.Uuid
  portfolio   Portfolio @relation("PortfolioReports", fields: [portfolioId], references: [id], onDelete: Cascade)

  reporterUserId String? @db.Uuid
  reporter       User?   @relation("ReportReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)

  reason  AbuseReportReason
  details String?
  status  AbuseReportStatus @default(OPEN)

  resolutionNote  String?
  statusChangedAt DateTime?
  resolvedAt      DateTime?
  // Traceability to the M6.3 moderation command/audit when ACTIONED.
  enforcementRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([portfolioId, createdAt])
  @@map("abuse_reports")
}

enum PortfolioPublicationStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

enum PortfolioModerationStatus {
  CLEAR
  UNDER_REVIEW
  SUSPENDED
}

model Portfolio {
  id      String @id @default(uuid()) @db.Uuid
  ownerId String @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  slug  String  @unique
  title String?

  // Draft template selection (public-template registry key + its version).
  // Lives on the draft; the published snapshot captures it immutably at publish.
  templateKey     String @default("minimal")
  templateVersion String @default("1.0.0")

  // Draft design customization (validated DesignConfig JSON). null = use the
  // template's identity defaults. Captured into the snapshot's theme at publish.
  design Json?

  publicationStatus PortfolioPublicationStatus @default(DRAFT)
  moderationStatus  PortfolioModerationStatus  @default(CLEAR)

  draftRevision     BigInt @default(0)
  nextVersionNumber Int    @default(1)

  // Active published snapshot. The composite relation enforces that the active
  // version belongs to this portfolio.
  activeVersionId String?           @db.Uuid
  activeVersion   PortfolioVersion? @relation("ActivePortfolioVersion", fields: [id, activeVersionId], references: [portfolioId, id], onDelete: NoAction, onUpdate: NoAction)

  lastDraftSavedAt DateTime?
  publishedAt      DateTime?
  deletedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Draft content (relational).
  profile     PortfolioProfile?
  sections    PortfolioSection[]
  projects    Project[]
  experiences Experience[]
  education   Education[]
  skills      Skill[]

  // Immutable published snapshots.
  versions PortfolioVersion[] @relation("PortfolioVersions")

  mediaAssets MediaAsset[]
  feedback    Feedback[]    @relation("PortfolioFeedback")
  reports     AbuseReport[] @relation("PortfolioReports")

  @@index([ownerId])
  @@index([publicationStatus, moderationStatus])
  @@index([id, activeVersionId])
  @@map("portfolios")
}

enum MediaAssetPurpose {
  PROFILE_AVATAR
  PROJECT_COVER
}

enum MediaAssetStatus {
  PENDING
  READY
  FAILED
  DELETING
}

enum MediaStorageProvider {
  R2
}

// Server-managed media asset (profile photos, project covers). An asset is
// created PENDING at upload initiation and only becomes READY after the server
// verifies the stored bytes — never because the browser reported success. Draft
// content references an asset by its UUID id (PortfolioProfile.avatarAssetId,
// Project.coverAssetId) and published snapshots embed that same id, so deleting
// an asset never mutates a published version (the renderer falls back). The
// storageKey is opaque and server-generated — never a user-supplied URL.
model MediaAsset {
  id String @id @default(uuid()) @db.Uuid

  ownerId String @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  // Every asset is scoped to a portfolio (quota + authorization boundary).
  portfolioId String    @db.Uuid
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Restrict)

  purpose  MediaAssetPurpose
  status   MediaAssetStatus     @default(PENDING)
  provider MediaStorageProvider @default(R2)

  // Opaque object-storage key (unguessable, server-generated). Unique so a key
  // is never reused across assets.
  storageKey String @unique

  // Verified at the server after upload; null until READY.
  contentType String?
  byteSize    Int?
  width       Int?
  height      Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  readyAt   DateTime?
  deletedAt DateTime?

  @@index([ownerId])
  @@index([portfolioId, status])
  @@index([status])
  @@map("media_assets")
}

model PortfolioVersion {
  id          String    @id @default(uuid()) @db.Uuid
  portfolioId String    @db.Uuid
  portfolio   Portfolio @relation("PortfolioVersions", fields: [portfolioId], references: [id], onDelete: Cascade)

  // Back-relation for the active-version pointer (no scalar fields on this side).
  activeFor Portfolio[] @relation("ActivePortfolioVersion")

  versionNumber       Int
  schemaVersion       Int
  sourceDraftRevision BigInt
  templateId          String
  templateVersion     String
  snapshot            Json   @db.JsonB
  contentHash         String

  publishedById String @db.Uuid
  publishedBy   User   @relation("VersionPublisher", fields: [publishedById], references: [id], onDelete: Restrict)

  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([portfolioId, versionNumber])
  @@unique([portfolioId, id])
  @@index([portfolioId, createdAt])
  @@map("portfolio_versions")
}

model PortfolioProfile {
  portfolioId String    @id @db.Uuid
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  displayName   String  @default("")
  headline      String?
  bio           String?
  location      String?
  avatarAssetId String? @db.Uuid
  emailPublic   String?

  updatedAt DateTime @updatedAt

  @@map("portfolio_profiles")
}

model PortfolioSection {
  id          String    @id @default(uuid()) @db.Uuid
  portfolioId String    @db.Uuid
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  sectionKey    String
  isVisible     Boolean @default(true)
  position      Int     @default(0)
  layoutVariant String?
  config        Json    @default("{}") @db.JsonB

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([portfolioId, sectionKey])
  @@index([portfolioId, position])
  @@map("portfolio_sections")
}

model Project {
  id          String    @id @default(uuid()) @db.Uuid
  portfolioId String    @db.Uuid
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  title         String
  summary       String?
  description   String?
  projectUrl    String?
  repositoryUrl String?
  coverAssetId  String? @db.Uuid
  isFeatured    Boolean @default(false)
  position      Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([portfolioId, position, id])
  @@map("projects")
}

model Experience {
  id          String    @id @default(uuid()) @db.Uuid
  portfolioId String    @db.Uuid
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  organization String
  roleTitle    String
  location     String?
  startDate    DateTime? @db.Date
  endDate      DateTime? @db.Date
  isCurrent    Boolean   @default(false)
  description  String?
  position     Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([portfolioId, position, id])
  @@map("experiences")
}

model Education {
  id          String    @id @default(uuid()) @db.Uuid
  portfolioId String    @db.Uuid
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  institution  String
  degree       String?
  fieldOfStudy String?
  startDate    DateTime? @db.Date
  endDate      DateTime? @db.Date
  description  String?
  position     Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([portfolioId, position, id])
  @@map("education")
}

model Skill {
  id          String    @id @default(uuid()) @db.Uuid
  portfolioId String    @db.Uuid
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  name        String
  category    String?
  proficiency String?
  position    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([portfolioId, position, id])
  @@map("skills")
}
